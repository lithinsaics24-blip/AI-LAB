import heapq

def get_neighbors(state):
    neighbors = []
    blank = state.index(0)
    r, c = blank // 3, blank % 3
    moves = []
    if r > 0: moves.append(-3) # Up
    if r < 2: moves.append(3)  # Down
    if c > 0: moves.append(-1) # Left
    if c < 2: moves.append(1)  # Right

    for m in moves:
        new_blank = blank + m
        temp = list(state)
        temp[blank], temp[new_blank] = temp[new_blank], temp[blank]
        neighbors.append(tuple(temp))
    return neighbors

def misplaced_tiles(state, goal):
    # Count tiles that are not in their goal position (excluding the blank tile 0)
    return sum(1 for s, g in zip(state, goal) if s != g and s != 0)

def a_star(start, goal):
    # Priority queue stores tuples of (f_score, g_score, current_state, path)
    # f_score = g_score + h_score
    queue = [(misplaced_tiles(start, goal), 0, start, [start])]
    visited = set()

    while queue:
        f, g, current, path = heapq.heappop(queue)

        if current == goal:
            return path

        if current in visited:
            continue
        visited.add(current)

        for neighbor in get_neighbors(current):
            if neighbor not in visited:
                new_g = g + 1
                new_f = new_g + misplaced_tiles(neighbor, goal)
                heapq.heappush(queue, (new_f, new_g, neighbor, path + [neighbor]))
    return None

start_state = (1, 2, 3, 4, 0, 5, 7, 8, 6)
goal_state = (1, 2, 3, 4, 5, 6, 7, 8, 0)

solution = a_star(start_state, goal_state)

if solution:
    print(f"Solved using A* in {len(solution) - 1} steps:")
    for step in solution:
        for i in range(0, 9, 3):
            print(step[i:i+3])
        print("-----")
else:
    print("No solution found.")

